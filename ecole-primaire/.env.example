# Copiez ce fichier en « .env » pour modifier la configuration (facultatif :
# sans fichier .env, les valeurs par défaut ci-dessous sont utilisées).

# Port de l'application sur votre ordinateur (http://localhost:3000)
PORT_APP=3000

# Mot de passe de la base de données (à changer en production)
DB_PASSWORD=ecole_mdp

# Données de démonstration chargées au premier démarrage (base vide)
SEED_DEMO=true
# Affiche les comptes de démonstration sur la page de connexion
DEMO_MODE=true

# Mise en service réelle (SEED_DEMO=false, base vide) : premier compte de la direction.
# Sans mot de passe, un mot de passe provisoire est affiché dans « docker compose logs app ».
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=

# Adresse publique de l'application (utilisée dans les e-mails).
# Laisser vide : elle est déduite automatiquement de l'adresse utilisée (ex. lien Cloudflare).
PUBLIC_URL=

# Secret de signature des sessions (laisser vide : généré automatiquement et conservé en base)
JWT_SECRET=

# Taille maximale d'un fichier envoyé (devoirs, pièces jointes, justificatifs), en Mo
TAILLE_MAX_FICHIER_MO=10

# E-mails (facultatif). Sans SMTP, les e-mails sont simulés et visibles dans
# « Journal d'activité > Envois ». Exemple avec SendGrid :
#   SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASS=<clé API>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="École primaire Aboukacem Chebbi <no-reply@exemple.tn>"
